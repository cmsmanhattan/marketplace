    <!-- Stripe payment channel (com.cbsinc.cms.payments). The webhook is the
         authoritative settlement path; the return servlet is where Stripe
         sends the customer's browser. Both are outside AuthFilter on purpose:
         Stripe has no session, and the return page verifies the session with
         the secret key rather than trusting the browser. -->
    <servlet>
        <servlet-name>StripeWebhook</servlet-name>
        <servlet-class>com.cbsinc.cms.payments.StripeWebhookServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StripeReturn</servlet-name>
        <servlet-class>com.cbsinc.cms.payments.StripeReturnServlet</servlet-class>
    </servlet>


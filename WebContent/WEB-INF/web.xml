    <!-- FIX: com.cbsinc.cms.AuthFilter exists in src/ and its javadoc lists the
         pages it is meant to guard, but it was never declared here, so it never
         ran and none of those pages were protected. Declared and mapped below.
         minAccessLevel 1 = any registered user (guests are level 0). Raise to 2
         to restrict a path to administrators. -->
    <filter>
      <filter-name>AuthFilter</filter-name>
      <filter-class>com.cbsinc.cms.AuthFilter</filter-class>
      <init-param>
        <param-name>minAccessLevel</param-name>
        <param-value>1</param-value>
      </init-param>
    </filter>

   

    
    <filter-mapping>
      <filter-name>RequestFilter</filter-name>
      <!-- FIX: "*" is not a legal url-pattern (Servlet 6.0 §12.2).
           A pattern must be "/", start with "/", or start with "*.".
           Tomcat 10 rejects the whole descriptor and the context fails to
           deploy. "/*" is the intended "every request" pattern. -->
      <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- AuthFilter runs ahead of FrontControllers so that an unauthenticated
         caller is redirected before any XSLT work is done. -->
    <filter-mapping>
      <filter-name>AuthFilter</filter-name>
      <url-pattern>/catalog_list.jsp</url-pattern>
    </filter-mapping>

    <filter-mapping>
